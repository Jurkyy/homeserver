# Secrets
.env

# Service configs (keep directories, ignore contents)
services/*/config/*
!services/*/config/.gitkeep

# Home Assistant config is tracked (production-ready YAML configs)
!services/homeassistant/config/*.yaml
!services/homeassistant/config/dashboards/
!services/homeassistant/config/dashboards/*.yaml
!services/homeassistant/config/themes/
!services/homeassistant/config/themes/*.yaml

# OpenClaw config is tracked (agent config, tools, system prompt)
!services/openclaw/config/openclaw.json
!services/openclaw/config/tools.json
!services/openclaw/config/system_prompt.md

# Mopidy config is tracked (player config with ALSA/Spotify/YouTube sections)
!services/mopidy/config/mopidy.conf

# Jellyfin cache
services/jellyfin/cache/*
!services/jellyfin/cache/.gitkeep

# Media mount references
/mnt/media

# Logs
*.log

# macOS
.DS_Store

# Python bytecode (e.g. from syntax-check runs against mediacast services)
__pycache__/
*.pyc
