<?xml version="1.0" encoding="utf-8"?>
<!-- LAN-only app: the media server is plain HTTP on the home network (homeserver.local / 192.168.0.22).
     User-installed CAs are trusted so Caddy's internal CA (https://home) works too. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </base-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">homeserver.local</domain>
        <domain includeSubdomains="false">192.168.0.22</domain>
        <domain includeSubdomains="true">local</domain>
        <domain includeSubdomains="true">lan</domain>
        <domain includeSubdomains="true">home</domain>
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </domain-config>
</network-security-config>
