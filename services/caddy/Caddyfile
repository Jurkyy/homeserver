# Caddy reverse proxy on :80 for LAN-only services.
#
# Plain HTTP because the published mDNS names (e.g. music.local from
# avahi-publish) can't get a Let's Encrypt cert, and an internal CA
# would mean trusting a custom root on every client.
{
	auto_https off
}

# Default :80 host — welcome page. Add reverse_proxy vhosts above this
# block as services come online (e.g. http://music.local -> librespot UI).
:80 {
	encode gzip
	root * /srv/welcome
	file_server
}
