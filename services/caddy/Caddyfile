# Caddy reverse proxy for the home server.
#
# Plain HTTP only on :80 — Tailscale-MagicDNS names (`homeserver`)
# and any router-DHCP-published LAN names can't get a public Let's
# Encrypt cert, and Caddy's internal CA would require every client
# to trust a custom root. LAN + tailnet traffic only.
#
# The catch-all proxies everything to the mediacast container, so
# `http://homeserver/` and `http://<lan-ip>/` both land directly on
# the cast UI — the box's most-used surface. Direct access on
# :8765 is still published (HTTP Shortcuts on Android targets it,
# and curl tests in INSTALL.md use it).
{
	auto_https off
}

:80 {
	encode gzip
	reverse_proxy mediacast:8765
}
