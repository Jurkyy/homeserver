# Caddy reverse proxy for the home server.
#
# Plain HTTP only on :80 — `.local` mDNS names cannot get a public
# Let's Encrypt cert, and Caddy's internal CA would require every
# client to trust a custom root. HTTP on the LAN is fine for now;
# revisit if/when we add real DNS + TLS.
#
# Note: there's no music vhost anymore. Spotify playback is handled
# by librespot as a Spotify Connect target (see docker-compose.yml),
# and the user controls it from the Spotify app — no browser UI to
# proxy. Requests to music.local fall through to the catch-all below
# and land on the welcome page.
{
	# Disable the on-by-default automatic HTTPS for the whole server.
	auto_https off
}

# Catch-all on :80: bare IP, Tailscale IP, *.local names — everything
# lands on the welcome page describing what's available on the box.
:80 {
	encode gzip
	root * /srv/welcome
	file_server
}
