# ===================================
# Home Server Configuration
# ===================================
# Copy this file to .env and fill in your values
# DO NOT commit .env to git!

# ===================================
# OpenClaw AI Agent
# ===================================
# Get your API key from https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-api03-...

# Alternative: OpenAI API key
# OPENAI_API_KEY=sk-...

# Gateway token (auto-generated on first run, or set manually)
OPENCLAW_GATEWAY_TOKEN=

# ===================================
# Discord Bot (for OpenClaw)
# ===================================
# Create a bot at https://discord.com/developers/applications
DISCORD_BOT_TOKEN=
DISCORD_CLIENT_ID=

# ===================================
# Home Assistant Integration
# ===================================
# Create a long-lived access token in HA:
#   Profile -> Security -> Long-Lived Access Tokens -> Create Token
# Used by OpenClaw to control lights, scenes, modes, media, etc.
HA_LONG_LIVED_TOKEN=
HA_URL=http://homeassistant:8123

# ===================================
# Spotify Integration (Home Assistant)
# ===================================
# Create a Spotify Developer App at https://developer.spotify.com/dashboard
# 1. Create a new app, set redirect URI to: http://localhost:8123/auth/external/callback
# 2. Copy Client ID and Client Secret below
# 3. After HA boots, go to Settings > Integrations > Add Integration > Spotify
# 4. Complete the OAuth flow to link your Spotify account
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# ===================================
# librespot (Spotify Connect target)
# ===================================
# Plays Spotify out the host's physical sound card via ALSA. No
# credentials are stored here — librespot advertises itself over mDNS
# zeroconf and the user's Spotify app (mobile or desktop) hands it a
# session token when they pick the device from the device list.
# REQUIRES SPOTIFY PREMIUM — free accounts can't drive Spotify Connect.

# Display name shown in the Spotify device picker.
LIBRESPOT_NAME=Homeserver

# The container must join the host `audio` group to access /dev/snd.
# Different distros use different GIDs — set this to match your host:
#   getent group audio | cut -d: -f3
# Debian/Ubuntu: 29, Arch: 996. Default is 29 (Debian 13).
LIBRESPOT_AUDIO_GID=29

# ALSA output device. Default targets the Focusrite Scarlett 2i2
# (USB → 1/4" TRS → speakers). Class-compliant USB cards usually show
# up with card name "USB" — confirm on the host with:
#   aplay -l
# Look for the line matching your Scarlett, e.g.:
#   card 2: USB [Scarlett 2i2 USB], device 0: USB Audio [USB Audio]
# Then set this to plughw:CARD=<name>,DEV=<device>. Use plughw (not hw)
# so ALSA resamples between Spotify's stream rate and the card's lock rate.
LIBRESPOT_ALSA_DEVICE=plughw:CARD=USB,DEV=0

# ===================================
# Tailscale VPN
# ===================================
# Get auth key from https://login.tailscale.com/admin/settings/keys
# Use a reusable key for convenience
TAILSCALE_AUTHKEY=tskey-auth-...

# ===================================
# NordVPN
# ===================================
# NordVPN — always-on whole-host VPN.
# Get a token at https://my.nordaccount.com/dashboard/nordvpn/access-tokens/
# Leave NORDVPN_TOKEN blank to install the client without auto-connecting.
NORDVPN_TOKEN=
# Optional: pin exit country (e.g. Netherlands, Germany, United_States).
# Affects Spotify catalog. Leave blank for Nord's auto-best pick.
NORDVPN_COUNTRY=

# ===================================
# Jellyfin (optional)
# ===================================
# External URL for Jellyfin (for client apps)
JELLYFIN_URL=http://localhost:8096

# ===================================
# Navidrome (music streaming)
# ===================================
# Music files are read from ${MEDIA_PATH}/music
# Access at http://localhost:4533
# First user to sign up becomes admin

# ===================================
# Mosquitto MQTT Broker
# ===================================
# Used by Home Assistant for MQTT device integration
# Anonymous access enabled (secured by Docker network)
# MQTT: port 1883, WebSocket: port 9001

# ===================================
# Storage paths
# ===================================
# Secondary HDD mounted by bootstrap.sh
# /mnt/storage/media     — Jellyfin media (movies, tv, music)
# /mnt/storage/backups   — Config backups
# /mnt/storage/docker    — Docker data
# /mnt/storage/projects  — Project data (databases, logs)
MEDIA_PATH=/mnt/storage/media

# ===================================
# Project Deployment
# ===================================
# SSH host for deployment (matches ~/.ssh/config)
DEPLOY_HOST=homeserver

# Projects directory on server
PROJECTS_DIR=~/projects
